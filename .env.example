# Copy this file to .env for local development.
# Do not commit real secrets.

# -------------------------------------------------------------------
# Auth
# -------------------------------------------------------------------
# Comma-separated API keys accepted by protected API endpoints.
# Use long random values outside local development.
API_KEYS=devkey1

# -------------------------------------------------------------------
# Database
# -------------------------------------------------------------------
# Local/demo SQLite:
DATABASE_URL=sqlite+aiosqlite:///./reviews.db
#
# Postgres example:
# DATABASE_URL=postgresql+asyncpg://reviews:reviews@localhost:5432/reviews
#
# Railway Postgres commonly provides postgres:// or postgresql://.
# The app normalizes those to postgresql+asyncpg:// automatically.

# -------------------------------------------------------------------
# Observability
# -------------------------------------------------------------------
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=60
IMAGE_MAX_BYTES=5242880

# -------------------------------------------------------------------
# Provider credentials
# -------------------------------------------------------------------
# Leave unused provider keys blank. Do not use real keys in this file.
ANTHROPIC_API_KEY=
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# -------------------------------------------------------------------
# Model pools
# -------------------------------------------------------------------
# Fast pool: cheap, low-latency models (comma-separated prefix:model_id)
# Supported prefixes: nim, anthropic
FAST_POOL=nim:meta/llama-3.3-70b-instruct,anthropic:claude-haiku-4-5

# Rich pool: strong models for two-stage deep analysis
RICH_POOL=nim:nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,anthropic:claude-opus-4-8

# -------------------------------------------------------------------
# Retry config (per pool member, applied by the retry layer)
# -------------------------------------------------------------------
RETRY_MAX_ATTEMPTS=2
RETRY_INITIAL_WAIT_S=1.0
RETRY_MAX_WAIT_S=10.0
PROVIDER_TIMEOUT_S=30.0
